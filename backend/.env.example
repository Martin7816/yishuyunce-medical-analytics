# Must be selected explicitly: fixture is for development, mysql is for production.
TOP10_DATA_SOURCE=fixture

# Only used when TOP10_DATA_SOURCE=fixture: success or empty
TOP10_FIXTURE_STATE=success
ANALYTICS_DATA_SOURCE=fixture

# Internal aggregate layer: leave unset until the reviewed MySQL schema is applied.
AGGREGATE_DATA_SOURCE=
# Final privacy threshold is policy-owned; do not choose a default here.
ANALYTICS_MIN_COHORT_SIZE=

# Optional high-cost model artifact exported by the PySpark training job.
HIGH_COST_MODEL_PATH=

# DeepSeek is required only for /api/v1/ai/chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=medical_api
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=medical_analytics
MYSQL_CONNECT_TIMEOUT=3
MYSQL_READ_TIMEOUT=30
# DeepSeek configuration
# Never commit a real API key. Put the real value in backend/.env only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
