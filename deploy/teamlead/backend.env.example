# Copy this file to backend/.env on the team lead's computer.
# Never commit backend/.env or replace_me values.

# Real MySQL-backed application mode.
TOP10_DATA_SOURCE=mysql
TOP10_FIXTURE_STATE=success
ANALYTICS_DATA_SOURCE=mysql
AGGREGATE_DATA_SOURCE=mysql

# Leave unset until the privacy policy owner supplies a reviewed threshold.
ANALYTICS_MIN_COHORT_SIZE=

# Optional local model artifact. Leave empty if the model page is not used.
HIGH_COST_MODEL_PATH=

# DeepSeek configuration for the AI assistant.
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20

# The default team-lead setup uses the SSH tunnel on local port 3307.
# For a direct database connection, replace these values with the reviewed
# direct host and port instead of running the tunnel.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=medical_api
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=medical_analytics
MYSQL_CONNECT_TIMEOUT=3
MYSQL_READ_TIMEOUT=30
